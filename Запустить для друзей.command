#!/bin/zsh -l
cd -- "${0:A:h}"
if curl --max-time 2 -fsS http://127.0.0.1:4174/api/status >/dev/null 2>&1; then
  print 'Сетевая игра уже запущена на порту 4174.'
  exit 0
fi
print 'Сейчас игра станет доступна устройствам в вашей локальной сети.'
print 'Отправьте друзьям адрес, который появится ниже. Оставьте это окно открытым.'
print 'Чтобы остановить игру для друзей, нажмите Ctrl+C.'
HOST=0.0.0.0 PORT=4174 node server.mjs
